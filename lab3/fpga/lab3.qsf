set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C20F484C7
set_global_assignment -name TOP_LEVEL_ENTITY lab3_top
set_global_assignment -name SYSTEMVERILOG_FILE lab3_top.sv
set_global_assignment -name QIP_FILE nios_system/synthesis/nios_system.qip
set_global_assignment -name SDC_FILE lab3.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2

# Terasic DE1 User Manual, tables 4.1, 4.2, 4.3 and 4.5.
set_location_assignment PIN_L1 -to clk_50
set_location_assignment PIN_R22 -to reset_n
set_location_assignment PIN_L22 -to switches[0]
set_location_assignment PIN_L21 -to switches[1]
set_location_assignment PIN_M22 -to switches[2]
set_location_assignment PIN_V12 -to switches[3]
set_location_assignment PIN_W12 -to switches[4]
set_location_assignment PIN_U12 -to switches[5]
set_location_assignment PIN_U11 -to switches[6]
set_location_assignment PIN_M2 -to switches[7]
set_location_assignment PIN_U22 -to leds[0]
set_location_assignment PIN_U21 -to leds[1]
set_location_assignment PIN_V22 -to leds[2]
set_location_assignment PIN_V21 -to leds[3]
set_location_assignment PIN_W22 -to leds[4]
set_location_assignment PIN_W21 -to leds[5]
set_location_assignment PIN_Y22 -to leds[6]
set_location_assignment PIN_Y21 -to leds[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to switches[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to leds[*]

set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim-Altera (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT VERILOG -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS COMMAND_MACRO_MODE -section_id eda_simulation
set_global_assignment -name EDA_SIMULATION_RUN_SCRIPT run_simulation.do -section_id eda_simulation
